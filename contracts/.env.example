# Private key for contract deployment
# IMPORTANT: Never commit your actual .env file with real private keys!
# This is a template - copy to .env and fill in your actual values

# Your wallet private key (without 0x prefix)
# Used for deploying contracts to Rootstock network
PRIVATE_KEY=your_private_key_here

# Optional: RPC URL override (if not using foundry.toml endpoints)
# RPC_URL=https://public-node.testnet.rsk.co

# Optional: Chain ID (31 for testnet, 30 for mainnet)
# CHAIN_ID=31

# Backend Server Configuration
PORT=3000

# API Security
# Generate a secure random string for production
API_KEY=your-secret-api-key-here

# RUNES Verification (Optional)
# Set to 'true' to use mock verification instead of real bridge API
USE_MOCK_RUNES_VERIFICATION=false

# Rootstock Bridge API (Optional - only needed if USE_MOCK_RUNES_VERIFICATION=false)
BRIDGE_API_URL=https://api.rootstock.io/bridge/v1
BRIDGE_API_KEY=your-bridge-api-key-here
